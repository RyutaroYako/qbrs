//! Shows `Superset`'s "this expression references a table that isn't in scope here" for
//! `excluded(..)` in a plain `UPDATE`, whose scope holds no `Excluded<users::Table>`.
//!
//! Copy into `tests/compile-bench/examples/` and run
//! `cargo build -p compile-bench --example excluded_outside_upsert`.
use qbrs::dialect::Postgres;
use qbrs::prelude::*;
use qbrs::update::{Assignments, update};

#[derive(Table)]
#[table(name = "users")]
#[allow(dead_code)]
struct Users {
    #[column(primary_key, generated)]
    id: i64,
    email: String,
}

fn main() {
    let _ = update(users::Table)
        .set(Assignments::set_to(users::email, excluded(users::email)))
        .to_sql(Postgres);
}
