//! Deliberately broken: `.order_by_selected(..)` handed a column the query
//! does not select. Shows the `row::Field` message a sort key outside the
//! selection reports. Copy into `tests/compile-bench/examples/` and run:
//!   cargo build -p compile-bench --example core_order_by_selected_unselected_column
use qbrs::prelude::*;

#[derive(Table)]
#[table(name = "users")]
#[allow(dead_code)]
struct Users {
    #[column(primary_key, generated)]
    id: i64,
    email: String,
    active: bool,
}

fn main() {
    let _ = select((users::id, users::email))
        .from(users::Table)
        .order_by_selected(users::active, SortDir::Asc)
        .to_sql(Postgres);
}
