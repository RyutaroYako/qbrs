//! Shows `Condition`'s "`Exists<Postgres, Nil>` isn't a condition" for an `EXISTS` built
//! for Postgres and filtered onto a MySQL statement.
//!
//! Copy into `tests/compile-bench/examples/` and run
//! `cargo build -p compile-bench --example exists_across_dialects`.
use qbrs::prelude::*;

#[derive(Table)]
#[table(name = "users")]
struct Users {
    #[column(primary_key, generated)]
    id: i64,
    email: String,
}

fn main() {
    let subquery = select((users::id,)).from::<Postgres, _>(users::Table);
    let (sql, _) = select((users::email,))
        .from::<MySql, _>(users::Table)
        .filter(subquery.exists())
        .to_sql(MySql);
    println!("{sql}");
}
