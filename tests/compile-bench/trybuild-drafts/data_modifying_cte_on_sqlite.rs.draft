//! Shows `SupportsDataModifyingCte`'s "`Sqlite` has no data-modifying CTE" for an
//! `UPDATE .. RETURNING` bound as a `WITH` body under SQLite.
//!
//! Copy into `tests/compile-bench/examples/` and run
//! `cargo build -p compile-bench --example data_modifying_cte_on_sqlite`.
use qbrs::dialect::Sqlite;
use qbrs::prelude::*;
use qbrs::update::update;

#[derive(Table)]
#[table(name = "orders")]
#[allow(dead_code)]
struct Orders {
    #[column(primary_key, generated)]
    id: i64,
    total: i64,
}

with! {
    struct raised { id: BigInt, total: BigInt }
}

fn main() {
    let bump: qbrs::statement::Returning<_, _> = update(orders::Table)
        .set_to(orders::total, 1i64)
        .returning((orders::id, orders::total));
    let _ = select((raised::id,))
        .from(cte::with(raised::Table, &bump))
        .to_sql(Sqlite);
}
