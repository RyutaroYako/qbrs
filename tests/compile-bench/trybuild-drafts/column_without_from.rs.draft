//! Shows `Find`'s "`users::Table` is not available in this query's scope" for a column
//! selected with no `FROM` at all.
//!
//! Copy into `tests/compile-bench/examples/` and run
//! `cargo build -p compile-bench --example column_without_from`.
use qbrs::dialect::Postgres;
use qbrs::prelude::*;

#[derive(Table)]
#[table(name = "users")]
#[allow(dead_code)]
struct Users {
    #[column(primary_key, generated)]
    id: i64,
    email: String,
}

fn main() {
    let _ = select((users::id,)).to_sql(Postgres);
}
