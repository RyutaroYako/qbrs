//! Deliberately broken: a selection naming `orders` on a query that never
//! joins it. Shows the `Find` message reported at the terminal
//! `.to_sql(..)`, where the selection meets the final scope. Copy into
//! `tests/compile-bench/examples/` and run:
//!   cargo build -p compile-bench --example core_select_without_its_join
use qbrs::prelude::*;

#[derive(Table)]
#[table(name = "users")]
#[allow(dead_code)]
struct Users {
    #[column(primary_key, generated)]
    id: i64,
    active: bool,
}

#[derive(Table)]
#[table(name = "orders")]
#[allow(dead_code)]
struct Orders {
    #[column(primary_key, generated)]
    id: i64,
    user_id: i64,
    total: i64,
}

fn main() {
    let _ = select((users::id, orders::total))
        .from(users::Table)
        .filter(users::active.eq(true))
        .to_sql(Postgres);
}
