//! Shows `SameNameAs`'s "`users::columns::email` can't stand in for
//! `picked::columns::nickname`" for a CTE body selecting the declared columns in the
//! other order.
//!
//! The message has to name reordering before renaming, since telling the reader to
//! `.label(..)` a swapped column sends them the wrong way. Both columns are `Text`, so the
//! pair at each position shares a type. Give them different types and `SameShape` reports
//! the same mistake instead.
//!
//! Copy into `tests/compile-bench/examples/` and run
//! `cargo build -p compile-bench --example sameshape_reordered`.
use qbrs::dialect::Postgres;
use qbrs::prelude::*;

#[derive(Table)]
#[table(name = "users")]
#[allow(dead_code)]
struct Users {
    #[column(primary_key, generated)]
    id: i64,
    email: String,
    nickname: String,
}

with! {
    struct picked { nickname: Text, email: Text }
}

fn main() {
    let body = select((users::email, users::nickname)).from(users::Table);
    let _ = select(picked::email)
        .from(qbrs::cte::with(picked::Table, &body))
        .to_sql(Postgres);
}
