//! Deliberately broken: `.order_by_selected(..)` handed an unlabelled `sql!`
//! fragment. Shows that an anonymous expression has no key to find a selected
//! one by, so one cannot stand in for another. Copy into
//! `tests/compile-bench/examples/` and run:
//!   cargo build -p compile-bench --example core_order_by_selected_unlabelled_expression
use qbrs::prelude::*;

#[derive(Table)]
#[table(name = "users")]
#[allow(dead_code)]
struct Users {
    #[column(primary_key, generated)]
    id: i64,
    email: String,
}

fn main() {
    let _ = select((sql!(Text, "upper(?)", users::email), users::id))
        .from(users::Table)
        .order_by_selected(sql!(Text, "lower(?)", users::email), SortDir::Asc)
        .to_sql(Postgres);
}
